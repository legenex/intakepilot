{
  "name": "OrganizationMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Reference to Organization"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "user_name": {
      "type": "string",
      "description": "Display name"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "operator",
        "viewer"
      ],
      "default": "viewer"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of inviter"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "removed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "organization_id",
    "user_email",
    "role"
  ]
}