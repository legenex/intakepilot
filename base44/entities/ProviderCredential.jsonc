{
  "name": "ProviderCredential",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "retell",
        "vapi",
        "twilio",
        "elevenlabs"
      ]
    },
    "credentials": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "error",
        "disconnected"
      ],
      "default": "disconnected"
    },
    "last_tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "provider"
  ]
}