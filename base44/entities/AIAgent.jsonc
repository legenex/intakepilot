{
  "name": "AIAgent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "voice_outbound",
        "voice_inbound",
        "sms_outbound",
        "sms_inbound",
        "warm_transfer"
      ],
      "default": "voice_outbound"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "draft"
      ],
      "default": "draft"
    },
    "verticals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_provider": {
      "type": "string",
      "enum": [
        "twilio",
        "vapi",
        "bland",
        "retell"
      ],
      "default": "vapi"
    },
    "phone_number": {
      "type": "string"
    },
    "voice_id": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string"
    },
    "greeting_message": {
      "type": "string"
    },
    "qualification_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transfer_to_buyer_id": {
      "type": "string"
    },
    "transfer_phone_number": {
      "type": "string"
    },
    "sms_template_initial": {
      "type": "string"
    },
    "sms_template_followup": {
      "type": "string"
    },
    "sms_template_qualified": {
      "type": "string"
    },
    "sms_template_dnc": {
      "type": "string"
    },
    "max_call_attempts": {
      "type": "number",
      "default": 3
    },
    "max_sms_attempts": {
      "type": "number",
      "default": 5
    },
    "retry_interval_minutes": {
      "type": "number",
      "default": 60
    },
    "calling_hours_start": {
      "type": "string",
      "default": "09:00"
    },
    "calling_hours_end": {
      "type": "string",
      "default": "20:00"
    },
    "calling_days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "total_calls_made": {
      "type": "number",
      "default": 0
    },
    "total_sms_sent": {
      "type": "number",
      "default": 0
    },
    "total_connected": {
      "type": "number",
      "default": 0
    },
    "total_qualified": {
      "type": "number",
      "default": 0
    },
    "total_transferred": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "name",
    "type"
  ]
}