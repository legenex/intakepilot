{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization display name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "personal_injury",
        "mass_tort",
        "workers_comp",
        "multi_vertical",
        "other"
      ],
      "description": "Practice area"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "unpaid",
        "paused"
      ],
      "default": "trialing"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_subscription_item_id_sms": {
      "type": "string"
    },
    "stripe_subscription_item_id_voice": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "agency"
      ],
      "default": "starter"
    },
    "plan_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "logo_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "internal_comped": {
      "type": "boolean",
      "default": false,
      "description": "When true, paywall logic ignores subscription_status. Used for internally supported accounts."
    },
    "soft_delete_at": {
      "type": "string",
      "format": "date-time",
      "description": "7-day grace period before hard deletion. Null if not marked for deletion."
    },
    "cancel_reason": {
      "type": "string",
      "description": "Reason captured from Stripe cancellation"
    }
  },
  "required": [
    "name"
  ]
}