{
  "name": "BillingUsage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    },
    "sms_count": {
      "type": "number",
      "default": 0
    },
    "voice_minutes": {
      "type": "number",
      "default": 0
    },
    "sms_overage_charge": {
      "type": "number",
      "default": 0
    },
    "voice_overage_charge": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id"
  ]
}