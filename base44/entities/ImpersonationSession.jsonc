{
  "name": "ImpersonationSession",
  "type": "object",
  "properties": {
    "super_admin_email": {
      "type": "string",
      "description": "Email of super admin initiating impersonation"
    },
    "target_user_email": {
      "type": "string",
      "description": "Email of user being impersonated"
    },
    "target_organization_id": {
      "type": "string",
      "description": "Organization context for impersonation"
    },
    "reason": {
      "type": "string",
      "enum": [
        "Customer Support",
        "Bug Investigation",
        "Account Recovery",
        "Data Verification",
        "Other"
      ],
      "description": "Reason for impersonation"
    },
    "reason_details": {
      "type": "string",
      "description": "Free text additional details"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "1 hour from started_at"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "super_admin_email",
    "target_user_email",
    "target_organization_id",
    "reason",
    "expires_at"
  ]
}