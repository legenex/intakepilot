{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30
    },
    "type": {
      "type": "string",
      "enum": [
        "callback",
        "consultation",
        "signing"
      ],
      "default": "callback"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "no_show",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "lead_id"
  ]
}