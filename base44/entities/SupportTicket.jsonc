{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Nullable \u2014 empty for public contact form"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responded",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}