{
  "name": "SMSCampaign",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "draft"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled",
        "status_change",
        "no_contact"
      ],
      "default": "immediate"
    },
    "target_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_verticals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "delay_hours": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "stop_on_reply": {
            "type": "boolean"
          }
        }
      }
    },
    "from_number": {
      "type": "string"
    },
    "total_sent": {
      "type": "number",
      "default": 0
    },
    "total_delivered": {
      "type": "number",
      "default": 0
    },
    "total_replies": {
      "type": "number",
      "default": 0
    },
    "total_optouts": {
      "type": "number",
      "default": 0
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "name"
  ]
}